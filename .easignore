# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

example

# generated native folders
/ios
/android

# Supabase/Sentry public config (copy from .env.example)
.env

# Terminal output saved for Claude to read (see cli-output/README in project instructions)
cli-output/

# Firebase service account keys (FCM V1). google-services.json is
# git-ignored but deliberately NOT listed here, so local builds include it.
*firebase-adminsdk*.json

# EAS: this file replaces .gitignore for uploads, so it repeats it above.
# The web admin is its own Next.js project; mobile builds don't need it.
web/
